(* Source: https://github.com/frarandone/DeGAS/blob/main/programs/SOGA/Optimization/CaseStudies/bnn2.soga
  Return the full original y array as a list, with no aggregation, loss, or added sampling. *)

let X =
  (-1.0) ::
  (-0.8947368860244751) ::
  (-0.7894736528396606) ::
  (-0.6842105388641357) ::
  (-0.5789473056793213) ::
  (-0.4736841917037964) ::
  (-0.3684210777282715) ::
  (-0.2631578743457794) ::
  (-0.15789473056793213) ::
  (-0.05263158679008484) ::
  (0.05263161659240723) ::
  (0.15789473056793213) ::
  (0.26315784454345703) ::
  (0.3684210777282715) ::
  (0.4736841917037964) ::
  (0.5789474248886108) ::
  (0.6842105388641357) ::
  (0.7894736528396606) ::
  (0.8947368860244751) ::
  (1.0) :: nil
in

let w100 = gaussian(_mu100, _sigma100) in
let w101 = gaussian(_mu101, _sigma101) in
let w110 = gaussian(_mu110, _sigma110) in
let w111 = gaussian(_mu111, _sigma111) in
let w200 = gaussian(_mu200, _sigma200) in
let w201 = gaussian(_mu201, _sigma201) in
let w210 = gaussian(_mu210, _sigma210) in
let w211 = gaussian(_mu211, _sigma211) in
let w300 = gaussian(_mu300, _sigma300) in
let w310 = gaussian(_mu310, _sigma310) in

let rec first_layer = fun inputs ->
  match inputs with
  | nil -> nil
  | x :: rest ->
      let a10 = w100 * x in
      let a10 = a10 + w110 in
      let a11 = w101 * x in
      let a11 = a11 + w111 in
      let a10 = if a10 < 0 then 0 else a10 in
      let a11 = if a11 < 0 then 0 else a11 in
      (a10, a11) :: first_layer rest
  end
in

let activations1 = first_layer X in

let rec second_layer = fun activations ->
  match activations with
  | nil -> nil
  | activation :: rest ->
      let a10 = fst activation in
      let a11 = snd activation in
      let a20 = w200 * a10 in
      let a20 = a20 + a11 * w210 in
      let a21 = w201 * a10 in
      let a21 = a21 + a11 * w211 in
      let a20 = if a20 < 0 then 0 else a20 in
      let a21 = if a21 < 0 then 0 else a21 in
      (a20, a21) :: second_layer rest
  end
in

let activations2 = second_layer activations1 in

let rec output_layer = fun activations ->
  match activations with
  | nil -> nil
  | activation :: rest ->
      let a20 = fst activation in
      let a21 = snd activation in
      let y = w300 * a20 in
      let y = y + a21 * w310 in
      let y = y + gaussian(0, 0.5) in
      y :: output_layer rest
  end
in

let y = output_layer activations2 in
y
