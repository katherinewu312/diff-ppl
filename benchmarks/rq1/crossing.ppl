(* RQ1-07: Intersecting surfaces with shared records.
   Parameter protocol: 0 < theta < 1.
   Genuine jumps: t = s with 0 < s < theta (magnitude 3);
   s = theta with t < theta (magnitude 1);
   t = theta with s > theta (magnitude 2).
   The diagonal is introduced under two different path conditions. *)

let s = uniform(0, 1) in
let t = uniform(0, 1) in
let first =
  if s < theta then
    if t < s then 1.0 else 0.0
  else 0.0 in
let second =
  if t < theta then
    if s > t then 2.0 else 0.0
  else 0.0 in
first + second
