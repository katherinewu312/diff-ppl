(* Original thermostat dynamics, with arrays represented as lists.
   Maximize expected negative mean squared observed-temperature error from 20. *)

let rec simulate = fun state ->
  let n = fst state in
  let pair = snd state in
  let temp = fst pair in
  let mode = snd pair in

  if n <= 0 then
    temp :: nil
  else
    let next_temp =
      if mode > 0 then
        0.99 * temp + 0.5 + gaussian(0, 0.1)
      else
        0.99 * temp + gaussian(0, 0.1)
    in
    let next_mode =
      if mode > 0 then
        if next_temp > _tOff then -1 else mode
      else
        if next_temp < _tOn then 1 else mode
    in
    if n <= 1 then
      next_temp :: nil
    else
      temp :: simulate (n - 1, (next_temp, next_mode))
in

let rec add_noise = fun xs ->
  match xs with
  | nil -> nil
  | head :: tail ->
      match tail with
      | nil -> head :: nil
      | next_head :: remaining ->
          (head + gaussian(0, 1)) :: add_noise tail
      end
  end
in

(* The final update overwrites T[30]; observation noise applies only to
   T[0] through T[29]. Preserve these observations in the reward. *)
let rec squared_error = fun temperatures ->
  match temperatures with
  | nil -> 0
  | temp :: rest ->
      let error = temp - 20 in
      error * error + squared_error rest
  end
in

0 - squared_error (add_noise (simulate (4, (16, -1)))) / 4
