(* From Teg's image-triangulation application (Bangaru et al., SIGGRAPH 2021). The original single triangle / pixel kernel. 

This uses the same three-edge coverage calculation as the Teg source, specialized to a unit pixel and one constant color channel. Uniform sampling over the unit pixel replaces Teg's integration primitive without changing the mathematical expectation.

*)


let x1 = 0.1 in
let y1 = 0.1 in

let x2 = 0.1 in
let y2 = 0.1 + theta in

let x3 = 0.7 in
let y3 = 0.1 in

let x = uniform(0, 1) in
let y = uniform(0, 1) in

let edge12 =
  x1 * y2 - x2 * y1 +
  (y1 - y2) * x +
  (x2 - x1) * y
in

let edge23 =
  x2 * y3 - x3 * y2 +
  (y2 - y3) * x +
  (x3 - x2) * y
in

let edge31 =
  x3 * y1 - x1 * y3 +
  (y3 - y1) * x +
  (x1 - x3) * y
in

if edge12 < 0 &&
   edge23 < 0 &&
   edge31 < 0
then 0.8
else 0

